# Copy this file to .env. Never commit the resulting .env file.

# Character image generation. Keep API keys server-side.
ARK_API_KEY=
ARK_API_STYLE=
ARK_IMAGE_MODEL=
ARK_BASE_URL=
# ARK_REQUEST_TIMEOUT_SECONDS=<YOUR_TIMEOUT_SECONDS>

# Optional character walking-video generation.
ARK_VIDEO_MODEL=

# OpenAI-compatible business-insight provider.
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_PRIMARY=
DEEPSEEK_MODEL_FALLBACK=
# DEEPSEEK_TIMEOUT_SECONDS=<YOUR_TIMEOUT_SECONDS>

# Local development and runtime directories.
# ALLOW_ORIGIN=<YOUR_ALLOWED_ORIGINS>
# PORT=<YOUR_PORT>
# UPLOAD_DIR=<YOUR_RUNTIME_UPLOAD_DIR>
# MAX_UPLOAD_BYTES=<YOUR_UPLOAD_LIMIT_BYTES>
# REMBG_MODEL=<YOUR_REMBG_MODEL>
# ASSET_CANVAS_SIZE=<YOUR_CANVAS_SIZE>
# ASSET_BASE_URL=<YOUR_LOCAL_ASSET_BASE_URL>
# ASSET_OUTPUT_DIR=<YOUR_GENERATED_ASSET_DIR>
# ASSET_DOWNLOAD_TIMEOUT_SECONDS=<YOUR_TIMEOUT_SECONDS>
